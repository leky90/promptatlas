---
import type { StyleRecord } from "../lib/styles";
import { paddedId, styleFacetLabel } from "../lib/styles";
import { evidenceForStyle } from "../lib/evidence";
import FavoriteButton from "./FavoriteButton.astro";
import ComposerEntry from "./ComposerEntry.astro";
import Icon from "./Icon.astro";

type Props = { style: StyleRecord; eager?: boolean };
const { style, eager = false } = Astro.props;
const evidence = evidenceForStyle(style);
const output = evidence.representative?.result ?? {
  path: style.images.chatgpt.full,
  thumbnailPath: style.images.chatgpt.thumb,
  width: style.images.chatgpt.width,
  height: style.images.chatgpt.height,
  alt: `${style.name} — ảnh tham chiếu.`,
};
const searchText = [style.name, style.title, style.subtitle, style.family, style.primaryFacet, style.summary, style.sourcePrompt, ...style.aliases, ...style.cues]
  .join(" ")
  .toLocaleLowerCase("vi");
---

<article
  class="style-card"
  data-style-card
  data-slug={style.slug}
  data-family={style.family}
  data-facet={style.primaryFacet}
  data-search={searchText}
>
  <a class="style-card__link" href={`/styles/${style.slug}/`} aria-label={`Xem phong cách ${style.name}`}>
    <figure class="style-card__output" data-learning-output data-image-frame>
      <img
        src={output.thumbnailPath}
        width={output.width}
        height={output.height}
        alt={output.alt}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        decoding="async"
      />
      <span class="image-load-state" data-image-load-state role="status" aria-live="polite" aria-atomic="true">Đang tải ảnh…</span>
      <figcaption><span>OUTPUT</span><span>{paddedId(style.id)}</span></figcaption>
    </figure>
    <div class="style-card__body">
      <div class="style-card__meta">
        <span>{paddedId(style.id)}</span>
        <span>{style.family} · {styleFacetLabel(style.primaryFacet)}</span>
      </div>
      <h2>{style.name}</h2>
      <p>{style.subtitle}</p>
      <p class="style-card__prompt-cue"><b>Prompt cue</b>{style.sourcePrompt}</p>
    </div>
  </a>
  <details class="style-card__prompt" data-prompt-disclosure>
    <summary><span>Xem prompt</span><Icon name="arrow-down" size={18} /></summary>
    <div class="style-card__prompt-preview">
      <pre data-prompt-preview tabindex="0"><code>{style.generationPrompt}</code></pre>
      <div class="style-card__actions" aria-label={`Dùng prompt ${style.name}`}>
        <ComposerEntry style={style} />
        <button
          class="card-action card-action--copy"
          type="button"
          data-copy-value={style.generationPrompt}
          data-copy-requires-preview
          aria-label={`Sao chép prompt ${style.name}`}
        >
          <Icon name="copy" size={18} />
          <span data-copy-label>Sao chép prompt</span>
        </button>
      </div>
    </div>
  </details>
  <div class="style-card__save"><FavoriteButton slug={style.slug} name={style.name} /></div>
</article>
