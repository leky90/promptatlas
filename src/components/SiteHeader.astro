---
const path = Astro.url.pathname;
const links = [
  ["/", "Atlas"],
  ["/compare/", "So sánh model"],
  ["/methodology/", "Phương pháp"],
] as const;
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="Prompt Atlas — trang chủ">
      <span class="brand__mark" aria-hidden="true"><i></i><i></i><b></b></span>
      <span class="brand__text"><strong>PROMPT ATLAS</strong><small>BY LDKTECH</small></span>
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-navigation">
      <span>Menu</span>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav class="site-nav" id="site-navigation" data-site-nav data-open="false" aria-label="Điều hướng chính">
      {links.map(([href, label]) => (
        <a href={href} aria-current={path === href || (href !== "/" && path.startsWith(href)) ? "page" : undefined}>{label}</a>
      ))}
      <a class="site-nav__external" href="https://github.com/leky90/image-styles" target="_blank" rel="noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

