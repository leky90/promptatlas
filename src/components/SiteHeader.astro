---
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const links = [
  ["/", "Xem kết quả"],
  ["/discover/", "Học primitives"],
  ["/anatomy/", "Image Anatomy"],
  ["/composer/", "Soạn prompt"],
  ["/review/", "Review mù"],
  ["/compare/", "Kiểm chứng provider"],
] as const;
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="Prompt Atlas — trang chủ">
      <img class="brand__mark" src="/brand/prompt-atlas-mark-reverse.svg" width="34" height="34" alt="" aria-hidden="true" />
      <span class="brand__text"><strong>PROMPT ATLAS</strong><small>BY LDKTECH</small></span>
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-navigation">
      <span>Menu</span>
      <Icon name="menu" size={20} />
    </button>
    <nav class="site-nav" id="site-navigation" data-site-nav data-open="false" aria-label="Điều hướng chính">
      {links.map(([href, label]) => href === "/composer/" ? (
        <a href={href} data-composer-nav aria-current={path.startsWith(href) ? "page" : undefined}>
          {label} <span class="site-nav__count" data-composer-count>0</span>
        </a>
      ) : (
        <a href={href} aria-current={href === "/" ? (path === "/" ? "page" : undefined) : (path.startsWith(href) ? "page" : undefined)}>{label}</a>
      ))}
    </nav>
  </div>
</header>
