---
import type { StyleRecord } from "../lib/styles";
import { evidenceForStyle } from "../lib/evidence";
import Icon from "./Icon.astro";
import ScoreRail from "./ScoreRail.astro";

type Props = { style: StyleRecord };
const { style } = Astro.props;
const evidence = evidenceForStyle(style);
const settingsLabel = (settings: (typeof evidence.results)[number]["settings"]) => settings.length
  ? settings.map((setting) => `${setting.name}: yêu cầu ${setting.requestedValue}; applied ${setting.appliedValue}; ${setting.supportStatus}`).join(" · ")
  : "Không ghi nhận";
---

<details
  class="evidence-panel shell"
  data-evidence-panel
  data-comparison-eligible={String(evidence.comparisonEligible)}
  data-learning-step="evidence"
>
  <summary>
    <span class="step-number">05 / EVIDENCE</span>
    <span>
      <strong>{evidence.comparisonEligible ? "Chẩn đoán product route" : "Ảnh tham chiếu"}</strong>
      <small>{evidence.comparisonEligible ? `${evidence.results.length} route cùng exact prompt · exploratory` : "Chưa đủ điều kiện so sánh provider"}</small>
    </span>
    <Icon name="arrow-down" size={20} />
  </summary>
  <div class="evidence-panel__body">
    {evidence.comparison && (
      <p class="evidence-classification" data-comparison-classification>Chẩn đoán product route lịch sử · không phải ranking model</p>
    )}
    {evidence.promptIdentity && (
      <p class="evidence-identity"><span>Prompt ID</span><code>{evidence.promptIdentity.id}</code><span>Hash</span><code>{evidence.promptIdentity.hash}</code></p>
    )}
    {evidence.prompt && (
      <details class="evidence-prompt">
        <summary>Xem exact prompt đã dùng</summary>
        <pre>{evidence.prompt.text}</pre>
      </details>
    )}
    <div class:list={["evidence-results", { "evidence-results--single": !evidence.comparisonEligible }]}>
      {evidence.results.map((item) => (
        <figure class:list={["evidence-result", evidence.comparisonEligible && `evidence-result--${item.provider.id}`]} data-evidence-result>
          <div class="evidence-result__image"><img src={item.result.path} width={item.result.width} height={item.result.height} alt={item.result.alt} loading="lazy" /></div>
          <figcaption>
            <dl>
              <div><dt>Provider</dt><dd>{item.provider.label}</dd></div>
              <div><dt>Model</dt><dd>{item.model.family}<small>{item.model.version}</small></dd></div>
              <div><dt>Model disclosure</dt><dd>{item.model.version}<small>{item.model.versionStatus} · {item.model.identityStatus}<br />{item.model.disclosure}</small></dd></div>
              <div><dt>Product route</dt><dd>{item.pipeline.label}<small>{item.pipeline.interface} · {item.pipeline.id}</small></dd></div>
              <div><dt>Settings</dt><dd>{settingsLabel(item.settings)}<small>Selection: {item.selectionPolicy}</small></dd></div>
              <div><dt>Output</dt><dd><code>{item.result.id}</code><small>Run: {item.result.runId}</small></dd></div>
            </dl>
          </figcaption>
        </figure>
      ))}
    </div>
    {evidence.comparison && (
      <div class="evidence-reading">
        <div>
          <p class="eyebrow">SCORING RATIONALE</p>
          <h3>Quan sát trên output đã chọn</h3>
          <p>{evidence.comparison.rationale}</p>
          <a class="button button--ghost" href={`/compare/?style=${style.slug}`}>Mở evidence mode <Icon name="arrow-up-right" /></a>
        </div>
        <ScoreRail scores={evidence.comparison.scores} />
      </div>
    )}
    {evidence.comparison && (
      <aside class="evidence-uncertainty" data-compare-uncertainty>
        <p class="eyebrow">UNCERTAINTY / ĐỘ BẤT ĐỊNH</p>
        <ul>{evidence.comparison.uncertainty.map((item) => <li>{item}</li>)}</ul>
      </aside>
    )}
  </div>
</details>
