---
import type { StyleRecord } from "../lib/styles";
import { scoreLabels } from "../lib/styles";

type Props = {
  scores: StyleRecord["scores"];
  compact?: boolean;
};

const { scores, compact = false } = Astro.props;
---

<div class:list={["score-rail", { "score-rail--compact": compact }]}>
  <div class="score-rail__head" aria-hidden="true">
    <span>Tiêu chí</span>
    <span class="score-rail__model score-rail__model--chatgpt">ChatGPT</span>
    <span class="score-rail__model score-rail__model--gemini">Gemini</span>
  </div>
  {scoreLabels.map(([key, label]) => (
    <div class="score-row">
      <span class="score-row__label">{label}</span>
      <div class="score-cell" aria-label={`ChatGPT: ${scores.chatgpt[key]} trên 10`}>
        <span class="score-cell__track"><i class="score-cell__bar score-cell__bar--chatgpt" style={`--score:${scores.chatgpt[key]}`}></i></span>
        <b>{scores.chatgpt[key].toFixed(1)}</b>
      </div>
      <div class="score-cell" aria-label={`Gemini: ${scores.gemini[key]} trên 10`}>
        <span class="score-cell__track"><i class="score-cell__bar score-cell__bar--gemini" style={`--score:${scores.gemini[key]}`}></i></span>
        <b>{scores.gemini[key].toFixed(1)}</b>
      </div>
    </div>
  ))}
  <div class="score-row score-row--average">
    <span class="score-row__label">Trung bình</span>
    <strong>{scores.chatgpt.average.toFixed(2)}</strong>
    <strong>{scores.gemini.average.toFixed(2)}</strong>
  </div>
</div>
