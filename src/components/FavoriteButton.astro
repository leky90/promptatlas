---
import Icon from "./Icon.astro";

type Props = { slug: string; name: string; compact?: boolean };
const { slug, name, compact = false } = Astro.props;
---

<button
  class:list={["favorite-button", { "favorite-button--compact": compact }]}
  type="button"
  data-favorite={slug}
  data-style-name={name}
  aria-pressed="false"
  aria-label={`Lưu phong cách ${name}`}
>
  <Icon name="bookmark" size={18} />
  <span data-favorite-label>{compact ? "" : "Lưu"}</span>
</button>
