---
import Icon from "./Icon.astro";
---

<details class="composer-tray" data-composer-tray hidden>
  <summary aria-label="Mở tóm tắt prompt đang soạn">
    <span class="composer-tray__mark" aria-hidden="true"></span>
    <span><strong data-composer-count>0</strong> thành phần trong prompt</span>
    <span class="composer-tray__toggle" aria-hidden="true">Mở</span>
  </summary>
  <div class="composer-tray__body">
    <p>Recipe được lưu trên thiết bị này.</p>
    <a href="/composer/" aria-label="Mở Composer">Mở Composer <Icon name="arrow-right" size={18} /></a>
  </div>
</details>
