---
import BaseLayout from "../layouts/BaseLayout.astro";
import PairCard from "../components/PairCard.astro";
import Icon from "../components/Icon.astro";
import { styleFacets, styles } from "../lib/styles";
import { evidenceForStyle } from "../lib/evidence";

const featured = styles.find((style) => style.id === 88) ?? styles[0];
const featuredEvidence = evidenceForStyle(featured);
const featuredOutput = featuredEvidence.representative?.result ?? {
  path: featured.images.chatgpt.full,
  width: featured.images.chatgpt.width,
  height: featured.images.chatgpt.height,
  alt: `${featured.name} — ảnh tham chiếu.`,
};
const featuredThumbnail = "thumbnailPath" in featuredOutput
  ? featuredOutput.thumbnailPath
  : featured.images.chatgpt.thumb;
const featuredMobileThumbnail = featured.id === 88
  ? "/media/thumbs/cyberpunk-plus-ukiyo-e-plus-glitch-art-chatgpt-mobile.webp"
  : featuredThumbnail;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Prompt Atlas — 105 phong cách tạo ảnh AI",
  description: "Kho prompt trực quan: nhìn output, hiểu cấu trúc prompt, rồi đưa thành phần vào Composer.",
  url: "https://prompt-atlas.ldktech.com/",
  numberOfItems: styles.length,
  isPartOf: { "@type": "WebSite", name: "Prompt Atlas by LDKTech", url: "https://prompt-atlas.ldktech.com/" },
};
---

<BaseLayout jsonLd={jsonLd} bodyClass="atlas-page">
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="eyebrow">VISUAL PROMPT REFERENCE / 2026</p>
      <h1 id="hero-title">Nhìn output trước.<br /><em>Hiểu prompt sau.</em></h1>
      <p class="hero__lead">Chọn một kết quả, đọc prompt tạo ra nó, rồi thay đúng thành phần bạn cần. Benchmark chỉ xuất hiện khi evidence đủ điều kiện.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#atlas">Xem kết quả <Icon name="arrow-down" /></a>
        <a class="button button--ghost" href="/discover/">Học primitives <Icon name="arrow-right" /></a>
      </div>
      <dl class="hero__metrics" aria-label="Quy mô dữ liệu">
        <div><dt>Phong cách</dt><dd>{styles.length}</dd></div>
        <div><dt>Facet V2</dt><dd>{styleFacets.length}</dd></div>
        <div><dt>Anatomy</dt><dd>116</dd></div>
      </dl>
    </div>
    <div class="hero__specimen" aria-label={`Output nổi bật ${featured.name}`}>
      <div class="hero__ruler" aria-hidden="true"><span>00</span><span>25</span><span>50</span><span>75</span><span>100</span></div>
      <figure class="hero__output" data-learning-output>
        <picture>
          <source media="(max-width: 820px)" srcset={featuredMobileThumbnail} />
          <img
            src={featuredOutput.path}
            width={featuredOutput.width}
            height={featuredOutput.height}
            alt={featuredOutput.alt}
            fetchpriority="high"
          />
        </picture>
        <figcaption><b>OUTPUT</b><span>prompt → image</span></figcaption>
      </figure>
      <div class="hero__caption">
        <span>{String(featured.id).padStart(3, "0")}</span>
        <strong>{featured.name}</strong>
        <span>{featured.family}</span>
      </div>
    </div>
  </section>

  <section class="atlas-section" id="atlas" aria-labelledby="atlas-title">
    <div class="atlas-toolbar-wrap">
      <div class="atlas-toolbar catalog-toolbar shell" data-catalog-toolbar="standard">
        <div class="search-field" data-catalog-search>
          <label for="style-search">Tìm phong cách hoặc ý tưởng</label>
          <span class="search-field__icon"><Icon name="search" size={18} /></span>
          <input id="style-search" type="search" autocomplete="off" placeholder="mực tàu, retro, 3D, Sài Gòn…" data-style-search />
        </div>
        <div class="filter-row" role="group" aria-label="Lọc theo facet phong cách V2" data-catalog-filters>
          <button class="filter-chip is-active" type="button" data-facet-filter="all" aria-pressed="true">Tất cả</button>
          {styleFacets.map((facet) => <button class="filter-chip" type="button" data-facet-filter={facet.id} aria-pressed="false">{facet.label}</button>)}
        </div>
        <div class="toolbar-status catalog-toolbar__status" data-catalog-status>
          <p><strong data-result-count>{styles.length}</strong> / {styles.length} phong cách</p>
          <button type="button" class="saved-filter" data-saved-filter aria-pressed="false">
            <Icon name="bookmark" size={18} />
            Chỉ xem đã lưu
          </button>
        </div>
      </div>
    </div>

    <div class="style-grid shell" data-style-grid>
      {styles.map((style) => <PairCard style={style} />)}
    </div>

    <div class="empty-state shell" data-empty-state hidden>
      <span class="empty-state__number">00</span>
      <div><h2>Chưa có phong cách nào khớp.</h2><p>Thử một từ ngắn hơn, đổi nhóm hoặc xóa bộ lọc.</p></div>
      <button type="button" class="button button--primary" data-reset-filters>Đặt lại tìm kiếm</button>
    </div>
  </section>

  <section class="evidence-strip">
    <div class="shell evidence-strip__grid">
      <div><p class="eyebrow">EVIDENCE MODE / PHỤ</p><h2>Chỉ so sánh khi dữ liệu cho phép.</h2></div>
      <p>Provider comparison chỉ mở cho output có cùng immutable prompt ID/hash và ít nhất hai provider. Mọi mẫu khác giữ một ảnh tham chiếu trung tính.</p>
      <div class="evidence-strip__actions">
        <a href="/compare/">Kiểm chứng provider <Icon name="arrow-right" /></a>
        <a href="/methodology/">Đọc phương pháp <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("[data-style-search]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-style-card]")];
    const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-facet-filter]")];
    const savedFilter = document.querySelector<HTMLButtonElement>("[data-saved-filter]");
    const count = document.querySelector<HTMLElement>("[data-result-count]");
    const empty = document.querySelector<HTMLElement>("[data-empty-state]");
    const grid = document.querySelector<HTMLElement>("[data-style-grid]");
    const reset = document.querySelector<HTMLButtonElement>("[data-reset-filters]");

    let activeFacet = "all";
    let savedOnly = false;

    const normalize = (value: string) => value.toLocaleLowerCase("vi").normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    const favorites = () => new Set(window.promptAtlas?.readFavorites?.() ?? []);

    function syncUrl() {
      const params = new URLSearchParams();
      if (search?.value.trim()) params.set("q", search.value.trim());
      if (activeFacet !== "all") params.set("facet", activeFacet);
      if (savedOnly) params.set("saved", "1");
      history.replaceState(null, "", `${location.pathname}${params.size ? `?${params}` : ""}${location.hash}`);
    }

    function applyFilters({ updateUrl = true } = {}) {
      const query = normalize(search?.value.trim() ?? "");
      const saved = favorites();
      let visible = 0;
      cards.forEach((card) => {
        const matchesQuery = !query || normalize(card.dataset.search ?? "").includes(query);
        const matchesFacet = activeFacet === "all" || card.dataset.facet === activeFacet;
        const favoriteKeys = [card.dataset.slug ?? "", ...(card.dataset.legacySlugs ?? "").split(/\s+/u)].filter(Boolean);
        const matchesSaved = !savedOnly || favoriteKeys.some((key) => saved.has(key));
        const show = matchesQuery && matchesFacet && matchesSaved;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = String(visible).padStart(2, "0");
      if (empty) empty.hidden = visible !== 0;
      if (grid) grid.hidden = visible === 0;
      if (updateUrl) syncUrl();
    }

    function setFacet(value: string) {
      activeFacet = value;
      filters.forEach((filter) => {
        const active = filter.dataset.facetFilter === value;
        filter.classList.toggle("is-active", active);
        filter.setAttribute("aria-pressed", String(active));
      });
    }

    const params = new URLSearchParams(location.search);
    const requestedFacet = params.get("facet");
    if (search) search.value = params.get("q") ?? "";
    if (requestedFacet && filters.some((filter) => filter.dataset.facetFilter === requestedFacet)) setFacet(requestedFacet);
    savedOnly = params.get("saved") === "1";
    savedFilter?.setAttribute("aria-pressed", String(savedOnly));
    savedFilter?.classList.toggle("is-active", savedOnly);
    applyFilters({ updateUrl: false });

    search?.addEventListener("input", () => applyFilters());
    filters.forEach((filter) => filter.addEventListener("click", () => {
      setFacet(filter.dataset.facetFilter ?? "all");
      applyFilters();
    }));
    savedFilter?.addEventListener("click", () => {
      savedOnly = !savedOnly;
      savedFilter.setAttribute("aria-pressed", String(savedOnly));
      savedFilter.classList.toggle("is-active", savedOnly);
      applyFilters();
    });
    reset?.addEventListener("click", () => {
      if (search) search.value = "";
      savedOnly = false;
      savedFilter?.setAttribute("aria-pressed", "false");
      savedFilter?.classList.remove("is-active");
      setFacet("all");
      applyFilters();
      search?.focus();
    });
    window.addEventListener("prompt-atlas:favorites-change", () => applyFilters({ updateUrl: false }));
  </script>
</BaseLayout>
