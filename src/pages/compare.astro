---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { scoreLabels, styles } from "../lib/styles";
import { evidenceForStyle } from "../lib/evidence";

const compareRecords = styles
  .map((style) => ({ style, evidence: evidenceForStyle(style) }))
  .filter((record) => record.evidence.comparisonEligible);
const initialRecord = compareRecords.find((record) => record.style.id === 88) ?? compareRecords[0];
if (!initialRecord) throw new Error("Compare requires at least one eligible same-prompt provider pair.");
const initial = initialRecord.style;
const [initialPrimary, initialSecondary] = initialRecord.evidence.results;
if (!initialPrimary || !initialSecondary) throw new Error("Eligible comparison requires two derived evidence results.");
const providerAverage = (provider: "chatgpt" | "gemini") => compareRecords.reduce((sum, record) => sum + record.style.scores[provider].average, 0) / compareRecords.length;
const chatgptAverage = providerAverage("chatgpt");
const geminiAverage = providerAverage("gemini");
const winCounts = compareRecords.reduce((result, record) => {
  result[record.style.winner] += 1;
  return result;
}, { ChatGPT: 0, Gemini: 0, Hòa: 0 });
const compareData = JSON.stringify(compareRecords);
---

<BaseLayout
  title="Kiểm chứng provider trên output cùng prompt | Prompt Atlas"
  description="Evidence mode chỉ hiển thị provider comparison khi ít nhất hai provider dùng cùng immutable prompt ID và hash."
  canonicalPath="/compare/"
  bodyClass="compare-page"
>
  <header class="compare-header shell">
    <p class="eyebrow">EVIDENCE MODE / {compareRecords.length} ELIGIBLE PROMPTS</p>
    <div class="compare-header__grid">
      <h1>So sánh bằng hình.<br /><em>Không bằng cảm giác.</em></h1>
      <p>Mỗi cặp đã qua guard: cùng immutable prompt ID/hash và có ít nhất hai provider. Taxonomy đọc theo provider → model → pipeline → result.</p>
    </div>
  </header>

  <section class="aggregate shell" data-comparison-eligible="true" aria-labelledby="aggregate-title">
    <div class="aggregate__intro">
      <p class="eyebrow">TOÀN BỘ BỘ MẪU</p>
      <h2 id="aggregate-title">Điểm trung bình</h2>
      <p>Đây là phép đo trên {compareRecords.length} prompt đủ điều kiện, không phải tuyên bố chất lượng tuyệt đối của model.</p>
    </div>
    <div class="aggregate__score aggregate__score--chatgpt"><span>ChatGPT</span><strong>{chatgptAverage.toFixed(2)}</strong><small>{winCounts.ChatGPT} thắng</small></div>
    <div class="aggregate__score aggregate__score--gemini"><span>Gemini</span><strong>{geminiAverage.toFixed(2)}</strong><small>{winCounts.Gemini} thắng</small></div>
    <div class="aggregate__ties"><strong>{winCounts.Hòa}</strong><span>kết quả hòa<br />trong biên độ 0,25</span></div>
  </section>

  <section class="compare-workbench" data-comparison-eligible="true" aria-labelledby="workbench-title">
    <div class="compare-toolbar shell">
      <div>
        <label for="compare-style">Phong cách đang xem</label>
        <select id="compare-style" data-compare-select>
          {compareRecords.map(({ style }) => <option value={style.slug} selected={style.slug === initial.slug}>{String(style.id).padStart(3, "0")} — {style.name}</option>)}
        </select>
      </div>
      <div class="compare-toolbar__pager" aria-label="Điều hướng phong cách">
        <button type="button" class="button button--ghost" data-compare-prev><Icon name="chevron-left" /> Trước</button>
        <button type="button" class="button button--ghost" data-compare-next>Tiếp <Icon name="chevron-right" /></button>
      </div>
    </div>

    <div class="shell workbench-title">
      <div><p class="eyebrow" data-compare-meta>{initial.family} / {String(initial.id).padStart(3, "0")}</p><h2 id="workbench-title" data-compare-name>{initial.name}</h2></div>
      <a class="button button--primary" data-compare-detail href={`/styles/${initial.slug}/`}>Xem prompt đầy đủ <Icon name="arrow-up-right" /></a>
    </div>

    <div class="shell compare-stage">
      <figure class="compare-stage__side compare-stage__side--chatgpt">
        <div><img data-compare-image="chatgpt" src={initialPrimary.result.path} width={initialPrimary.result.width} height={initialPrimary.result.height} alt={initialPrimary.result.alt} fetchpriority="high" /></div>
        <figcaption>
          <dl class="compare-stage__taxonomy" data-compare-taxonomy="chatgpt">
            <div><dt>Provider</dt><dd data-compare-provider="chatgpt">{initialPrimary.provider.label}</dd></div>
            <div><dt>Model</dt><dd data-compare-model="chatgpt">{initialPrimary.model.family}</dd></div>
            <div><dt>Pipeline</dt><dd data-compare-pipeline="chatgpt">{initialPrimary.pipeline.label}</dd></div>
            <div><dt>Result</dt><dd data-compare-result="chatgpt">{initialPrimary.result.id}</dd></div>
          </dl>
          <strong data-compare-average="chatgpt">{initial.scores.chatgpt.average.toFixed(2)}</strong>
        </figcaption>
      </figure>
      <figure class="compare-stage__side compare-stage__side--gemini">
        <div><img data-compare-image="gemini" src={initialSecondary.result.path} width={initialSecondary.result.width} height={initialSecondary.result.height} alt={initialSecondary.result.alt} fetchpriority="high" /></div>
        <figcaption>
          <dl class="compare-stage__taxonomy" data-compare-taxonomy="gemini">
            <div><dt>Provider</dt><dd data-compare-provider="gemini">{initialSecondary.provider.label}</dd></div>
            <div><dt>Model</dt><dd data-compare-model="gemini">{initialSecondary.model.family}</dd></div>
            <div><dt>Pipeline</dt><dd data-compare-pipeline="gemini">{initialSecondary.pipeline.label}</dd></div>
            <div><dt>Result</dt><dd data-compare-result="gemini">{initialSecondary.result.id}</dd></div>
          </dl>
          <strong data-compare-average="gemini">{initial.scores.gemini.average.toFixed(2)}</strong>
        </figcaption>
      </figure>
      <span class="compare-stage__seam" aria-hidden="true">VS</span>
    </div>

    <div class="shell compare-reading">
      <div class="compare-reading__note">
        <p class="eyebrow">NHẬN XÉT</p>
        <h3 data-compare-winner>{initial.winner === "Hòa" ? "Hòa trong biên độ 0,25" : `${initial.winner} nhỉnh hơn`}</h3>
        <p data-compare-observation>{initial.observation}</p>
      </div>
      <div class="compare-score-table" data-compare-scores>
        <div class="compare-score-table__head"><span>Tiêu chí</span><span>ChatGPT</span><span>Gemini</span></div>
        {scoreLabels.map(([key, label]) => (
          <div class="compare-score-table__row" data-score-key={key}>
            <span>{label}</span><strong data-score-provider="chatgpt">{initial.scores.chatgpt[key].toFixed(1)}</strong><strong data-score-provider="gemini">{initial.scores.gemini[key].toFixed(1)}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="compare-method shell">
    <p><b>Cách đọc:</b> điểm 1–10 do cùng một quy trình đánh giá có cấu trúc. Chênh lệch nhỏ hơn 0,25 được xem là hòa.</p>
    <a href="/methodology/">Xem phương pháp và giới hạn <Icon name="arrow-right" /></a>
  </section>

  <script is:inline id="compare-data" type="application/json" set:html={compareData}></script>
  <script>
    type CompareStyle = (typeof import("../data/styles.json"))[number];
    type CompareEvidenceResult = {
      provider: { id: string; label: string };
      model: { family: string; version: string };
      pipeline: { id: string; label: string; interface: string };
      result: { id: string; path: string; width: number; height: number; alt: string };
    };
    type CompareRecord = { style: CompareStyle; evidence: { results: CompareEvidenceResult[] } };
    const dataNode = document.querySelector<HTMLScriptElement>("#compare-data");
    const records = JSON.parse(dataNode?.textContent ?? "[]") as CompareRecord[];
    const select = document.querySelector<HTMLSelectElement>("[data-compare-select]");

    function render(slug: string, sync = true) {
      const record = records.find((item) => item.style.slug === slug) ?? records[0];
      if (!record || !select) return;
      const { style, evidence } = record;
      if (evidence.results.length < 2) return;
      select.value = style.slug;
      const meta = document.querySelector<HTMLElement>("[data-compare-meta]");
      const name = document.querySelector<HTMLElement>("[data-compare-name]");
      const detail = document.querySelector<HTMLAnchorElement>("[data-compare-detail]");
      const winner = document.querySelector<HTMLElement>("[data-compare-winner]");
      const observation = document.querySelector<HTMLElement>("[data-compare-observation]");
      if (meta) meta.textContent = `${style.family} / ${String(style.id).padStart(3, "0")}`;
      if (name) name.textContent = style.name;
      if (detail) detail.href = `/styles/${style.slug}/`;
      if (winner) winner.textContent = style.winner === "Hòa" ? "Hòa trong biên độ 0,25" : `${style.winner} nhỉnh hơn`;
      if (observation) observation.textContent = style.observation;
      (["chatgpt", "gemini"] as const).forEach((provider, index) => {
        const evidenceResult = evidence.results[index];
        const image = document.querySelector<HTMLImageElement>(`[data-compare-image="${provider}"]`);
        const average = document.querySelector<HTMLElement>(`[data-compare-average="${provider}"]`);
        if (image && evidenceResult) {
          image.src = evidenceResult.result.path;
          image.width = evidenceResult.result.width;
          image.height = evidenceResult.result.height;
          image.alt = evidenceResult.result.alt;
        }
        if (average) average.textContent = style.scores[provider].average.toFixed(2);
        const taxonomy = {
          provider: evidenceResult?.provider.label,
          model: evidenceResult?.model.family,
          pipeline: evidenceResult?.pipeline.label,
          result: evidenceResult?.result.id,
        };
        Object.entries(taxonomy).forEach(([key, value]) => {
          const cell = document.querySelector<HTMLElement>(`[data-compare-${key}="${provider}"]`);
          if (cell && value) cell.textContent = value;
        });
      });
      document.querySelectorAll<HTMLElement>("[data-score-key]").forEach((row) => {
        const key = row.dataset.scoreKey as keyof Omit<CompareStyle["scores"]["chatgpt"], "average">;
        (["chatgpt", "gemini"] as const).forEach((provider) => {
          const cell = row.querySelector<HTMLElement>(`[data-score-provider="${provider}"]`);
          if (cell) cell.textContent = style.scores[provider][key].toFixed(1);
        });
      });
      if (sync) history.replaceState(null, "", `${location.pathname}?style=${style.slug}`);
    }

    const requested = new URLSearchParams(location.search).get("style");
    render(requested ?? select?.value ?? records[0]?.style.slug, false);
    select?.addEventListener("change", () => render(select.value));
    document.querySelector("[data-compare-prev]")?.addEventListener("click", () => {
      if (!select) return;
      const index = Math.max(0, records.findIndex((item) => item.style.slug === select.value));
      render(records[(index - 1 + records.length) % records.length].style.slug);
    });
    document.querySelector("[data-compare-next]")?.addEventListener("click", () => {
      if (!select) return;
      const index = Math.max(0, records.findIndex((item) => item.style.slug === select.value));
      render(records[(index + 1) % records.length].style.slug);
    });
  </script>
</BaseLayout>
