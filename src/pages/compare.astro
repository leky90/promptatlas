---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { evidenceForStyle, scoreAxes, type EvidenceResult } from "../lib/evidence";
import { styles } from "../lib/styles";

const compareRecords = styles
  .map((style) => {
    const evidence = evidenceForStyle(style);
    if (!evidence.comparisonEligible || !evidence.prompt || !evidence.comparison) return null;
    return {
      style: { id: style.id, slug: style.slug, name: style.name, family: style.family },
      evidence: {
        prompt: evidence.prompt,
        classification: evidence.comparison.classification,
        scores: evidence.comparison.scores,
        results: evidence.comparison.results,
        rationale: evidence.comparison.rationale,
        uncertainty: evidence.comparison.uncertainty,
      },
    };
  })
  .filter((record): record is NonNullable<typeof record> => Boolean(record));
const initialRecord = compareRecords.find((record) => record.style.id === 88) ?? compareRecords[0];
if (!initialRecord) throw new Error("Compare requires at least one eligible same-prompt provider pair.");
const initial = initialRecord.style;
const initialPrompt = initialRecord.evidence.prompt;
const initialEvidence = initialRecord.evidence;
const { chatgpt: initialPrimary, gemini: initialSecondary } = initialEvidence.results;
if (!initialPrimary || !initialSecondary || !initialPrompt) {
  throw new Error("Eligible comparison requires two inspectable evidence results and one exact prompt.");
}
const settingsLabel = (result: EvidenceResult) => result.settings.length
  ? result.settings.map((setting) => `${setting.name}: yêu cầu ${setting.requestedValue}; applied ${setting.appliedValue}; ${setting.supportStatus}`).join(" · ")
  : "Không ghi nhận";
const modelDisclosureLabel = (result: EvidenceResult) => `${result.model.version} · ${result.model.versionStatus} · ${result.model.identityStatus}`;
const compareData = JSON.stringify(compareRecords);
---

<BaseLayout
  title="Chẩn đoán product route trên output cùng prompt | Prompt Atlas"
  description="Evidence view tách tuân thủ prompt, thẩm mỹ và artifact; đồng thời công khai prompt, route, model disclosure, settings, output và uncertainty."
  canonicalPath="/compare/"
  bodyClass="compare-page"
>
  <header class="compare-header shell">
    <p class="eyebrow">EVIDENCE MODE / {compareRecords.length} ELIGIBLE PROMPTS</p>
    <div class="compare-header__grid">
      <h1>Đọc bằng chứng.<br /><em>Không xếp hạng model.</em></h1>
      <p>Mỗi cặp dùng cùng immutable prompt ID/hash. Đây là dữ liệu product route lịch sử, dùng để quan sát output đã chọn chứ không đại diện cho một API model snapshot bất biến.</p>
    </div>
  </header>

  <section class="aggregate aggregate--axes shell" data-comparison-classification aria-labelledby="aggregate-title">
    <div class="aggregate__intro">
      <p class="eyebrow">PHẠM VI BẰNG CHỨNG</p>
      <h2 id="aggregate-title">Chẩn đoán product route lịch sử</h2>
      <p>{compareRecords.length} prompt đủ điều kiện cùng prompt identity. Không dùng overall average, số lần thắng hay tuyên bố “model tốt nhất”.</p>
    </div>
    {scoreAxes.map((axis, index) => (
      <article class="aggregate__axis">
        <span>0{index + 1}</span>
        <h3>{axis.label}</h3>
        <p>{axis.description}</p>
      </article>
    ))}
  </section>

  <section class="compare-workbench" data-comparison-eligible="true" aria-labelledby="workbench-title">
    <div class="compare-toolbar shell">
      <div>
        <label for="compare-style">Phong cách đang xem</label>
        <select id="compare-style" data-compare-select>
          {compareRecords.map(({ style }) => <option value={style.slug} selected={style.slug === initial.slug}>{String(style.id).padStart(3, "0")} — {style.name}</option>)}
        </select>
      </div>
      <div class="compare-toolbar__pager" aria-label="Điều hướng phong cách">
        <button type="button" class="button button--ghost" data-compare-prev><Icon name="chevron-left" /> Trước</button>
        <button type="button" class="button button--ghost" data-compare-next>Tiếp <Icon name="chevron-right" /></button>
      </div>
    </div>

    <div class="shell workbench-title">
      <div><p class="eyebrow" data-compare-meta>{initial.family} / {String(initial.id).padStart(3, "0")}</p><h2 id="workbench-title" data-compare-name>{initial.name}</h2></div>
      <a class="button button--primary" data-compare-detail href={`/styles/${initial.slug}/`}>Xem trang phong cách <Icon name="arrow-up-right" /></a>
    </div>

    <details class="shell compare-prompt" data-compare-prompt open>
      <summary><span>Exact prompt</span><small>Cùng ID/hash cho hai route</small></summary>
      <dl>
        <div><dt>Prompt ID</dt><dd><code data-compare-prompt-id>{initialPrompt.id}</code></dd></div>
        <div><dt>SHA-256</dt><dd><code data-compare-prompt-hash>{initialPrompt.hash}</code></dd></div>
      </dl>
      <pre data-compare-prompt-text>{initialPrompt.text}</pre>
    </details>

    <div class="shell compare-stage">
      <figure class="compare-stage__side compare-stage__side--chatgpt">
        <div><img data-compare-image="chatgpt" src={initialPrimary.result.path} width={initialPrimary.result.width} height={initialPrimary.result.height} alt={initialPrimary.result.alt} fetchpriority="high" /></div>
        <figcaption>
          <dl class="compare-stage__taxonomy" data-compare-taxonomy="chatgpt">
            <div><dt>Provider</dt><dd data-compare-provider="chatgpt">{initialPrimary.provider.label}</dd></div>
            <div><dt>Model</dt><dd data-compare-model="chatgpt">{initialPrimary.model.family}</dd></div>
            <div><dt>Model disclosure</dt><dd data-compare-model-disclosure="chatgpt">{modelDisclosureLabel(initialPrimary)}<small>{initialPrimary.model.disclosure}</small></dd></div>
            <div><dt>Product route</dt><dd data-compare-route="chatgpt">{initialPrimary.pipeline.label}<small>{initialPrimary.pipeline.interface} · {initialPrimary.pipeline.id}</small></dd></div>
            <div><dt>Settings</dt><dd data-compare-settings="chatgpt">{settingsLabel(initialPrimary)}<small>Selection: {initialPrimary.selectionPolicy}</small></dd></div>
            <div><dt>Output</dt><dd data-compare-output="chatgpt">{initialPrimary.result.id}<small>Run: {initialPrimary.result.runId}</small></dd></div>
          </dl>
        </figcaption>
      </figure>
      <figure class="compare-stage__side compare-stage__side--gemini">
        <div><img data-compare-image="gemini" src={initialSecondary.result.path} width={initialSecondary.result.width} height={initialSecondary.result.height} alt={initialSecondary.result.alt} fetchpriority="high" /></div>
        <figcaption>
          <dl class="compare-stage__taxonomy" data-compare-taxonomy="gemini">
            <div><dt>Provider</dt><dd data-compare-provider="gemini">{initialSecondary.provider.label}</dd></div>
            <div><dt>Model</dt><dd data-compare-model="gemini">{initialSecondary.model.family}</dd></div>
            <div><dt>Model disclosure</dt><dd data-compare-model-disclosure="gemini">{modelDisclosureLabel(initialSecondary)}<small>{initialSecondary.model.disclosure}</small></dd></div>
            <div><dt>Product route</dt><dd data-compare-route="gemini">{initialSecondary.pipeline.label}<small>{initialSecondary.pipeline.interface} · {initialSecondary.pipeline.id}</small></dd></div>
            <div><dt>Settings</dt><dd data-compare-settings="gemini">{settingsLabel(initialSecondary)}<small>Selection: {initialSecondary.selectionPolicy}</small></dd></div>
            <div><dt>Output</dt><dd data-compare-output="gemini">{initialSecondary.result.id}<small>Run: {initialSecondary.result.runId}</small></dd></div>
          </dl>
        </figcaption>
      </figure>
      <span class="compare-stage__seam" aria-hidden="true">↔</span>
    </div>

    <div class="shell compare-reading">
      <div class="compare-reading__note">
        <p class="eyebrow">SCORING RATIONALE</p>
        <h3>Quan sát trên output đã chọn</h3>
        <p data-compare-rationale>{initialEvidence.rationale}</p>
      </div>
      <div class="compare-score-table" data-compare-scores>
        <div class="compare-score-table__head"><span>Trục / tiêu chí</span><span>ChatGPT</span><span>Gemini</span></div>
        {scoreAxes.map((axis) => (
          <section class="compare-score-axis" data-score-axis={axis.id} aria-labelledby={`compare-axis-${axis.id}`}>
            <header>
              <h4 id={`compare-axis-${axis.id}`}>{axis.label}</h4>
              <p>{axis.description}</p>
            </header>
            {axis.metrics.map(([key, label]) => (
              <div class="compare-score-table__row" data-score-key={key}>
                <span>{label}</span><strong data-score-provider="chatgpt">{initialEvidence.scores.chatgpt[key].toFixed(1)}</strong><strong data-score-provider="gemini">{initialEvidence.scores.gemini[key].toFixed(1)}</strong>
              </div>
            ))}
          </section>
        ))}
      </div>
    </div>

    <aside class="shell compare-uncertainty" data-compare-uncertainty aria-labelledby="uncertainty-title">
      <div><p class="eyebrow">UNCERTAINTY</p><h3 id="uncertainty-title">Điều dữ liệu này chưa chứng minh</h3></div>
      <ul>{initialEvidence.uncertainty.map((item) => <li>{item}</li>)}</ul>
    </aside>
  </section>

  <section class="compare-method shell">
    <p><b>Cách đọc:</b> đọc từng trục độc lập và đối chiếu với exact prompt, route disclosure, settings cùng output. Giá trị thiếu hoặc unknown được giữ nguyên, không nội suy.</p>
    <a href="/methodology/">Xem phương pháp và giới hạn <Icon name="arrow-right" /></a>
  </section>

  <script is:inline id="compare-data" type="application/json" set:html={compareData}></script>
  <script>
    type CompareStyle = { id: number; slug: string; name: string; family: string };
    type CompareProviderScores = {
      promptAdherence: number;
      styleFidelity: number;
      composition: number;
      technicalQuality: number;
      detailIntegrity: number;
    };
    type CompareEvidenceResult = {
      provider: { id: string; label: string };
      model: { family: string; version: string; identityStatus: string; versionStatus: string; disclosure: string };
      pipeline: { id: string; label: string; interface: string };
      settings: Array<{ name: string; requestedValue: string; appliedValue: string; supportStatus: string; note: string }>;
      selectionPolicy: string;
      result: { id: string; runId: string; path: string; width: number; height: number; alt: string };
    };
    type CompareRecord = {
      style: CompareStyle;
      evidence: {
        prompt: { id: string; hash: string; text: string };
        scores: Record<"chatgpt" | "gemini", CompareProviderScores>;
        results: Record<"chatgpt" | "gemini", CompareEvidenceResult>;
        rationale: string;
        uncertainty: string[];
      };
    };
    const dataNode = document.querySelector<HTMLScriptElement>("#compare-data");
    const records = JSON.parse(dataNode?.textContent ?? "[]") as CompareRecord[];
    const select = document.querySelector<HTMLSelectElement>("[data-compare-select]");
    const settingsText = (result: CompareEvidenceResult) => result.settings.length
      ? result.settings.map((setting) => `${setting.name}: yêu cầu ${setting.requestedValue}; applied ${setting.appliedValue}; ${setting.supportStatus}`).join(" · ")
      : "Không ghi nhận";

    function render(slug: string, sync = true) {
      const record = records.find((item) => item.style.slug === slug) ?? records[0];
      if (!record || !select) return;
      const { style, evidence } = record;
      if (!evidence.results.chatgpt || !evidence.results.gemini || !evidence.prompt) return;
      select.value = style.slug;
      const meta = document.querySelector<HTMLElement>("[data-compare-meta]");
      const name = document.querySelector<HTMLElement>("[data-compare-name]");
      const detail = document.querySelector<HTMLAnchorElement>("[data-compare-detail]");
      const rationale = document.querySelector<HTMLElement>("[data-compare-rationale]");
      const promptId = document.querySelector<HTMLElement>("[data-compare-prompt-id]");
      const promptHash = document.querySelector<HTMLElement>("[data-compare-prompt-hash]");
      const promptText = document.querySelector<HTMLElement>("[data-compare-prompt-text]");
      if (meta) meta.textContent = `${style.family} / ${String(style.id).padStart(3, "0")}`;
      if (name) name.textContent = style.name;
      if (detail) detail.href = `/styles/${style.slug}/`;
      if (rationale) rationale.textContent = evidence.rationale;
      if (promptId) promptId.textContent = evidence.prompt.id;
      if (promptHash) promptHash.textContent = evidence.prompt.hash;
      if (promptText) promptText.textContent = evidence.prompt.text;
      (["chatgpt", "gemini"] as const).forEach((provider) => {
        const evidenceResult = evidence.results[provider];
        const image = document.querySelector<HTMLImageElement>(`[data-compare-image="${provider}"]`);
        if (image && evidenceResult) {
          image.src = evidenceResult.result.path;
          image.width = evidenceResult.result.width;
          image.height = evidenceResult.result.height;
          image.alt = evidenceResult.result.alt;
        }
        if (!evidenceResult) return;
        const taxonomy = {
          provider: evidenceResult.provider.label,
          model: evidenceResult.model.family,
          "model-disclosure": `${evidenceResult.model.version} · ${evidenceResult.model.versionStatus} · ${evidenceResult.model.identityStatus}\n${evidenceResult.model.disclosure}`,
          route: `${evidenceResult.pipeline.label}\n${evidenceResult.pipeline.interface} · ${evidenceResult.pipeline.id}`,
          settings: `${settingsText(evidenceResult)}\nSelection: ${evidenceResult.selectionPolicy}`,
          output: `${evidenceResult.result.id}\nRun: ${evidenceResult.result.runId}`,
        };
        Object.entries(taxonomy).forEach(([key, value]) => {
          const cell = document.querySelector<HTMLElement>(`[data-compare-${key}="${provider}"]`);
          if (cell) cell.textContent = value;
        });
      });
      document.querySelectorAll<HTMLElement>("[data-score-key]").forEach((row) => {
        const key = row.dataset.scoreKey as keyof CompareProviderScores;
        (["chatgpt", "gemini"] as const).forEach((provider) => {
          const cell = row.querySelector<HTMLElement>(`[data-score-provider="${provider}"]`);
          if (cell) cell.textContent = evidence.scores[provider][key].toFixed(1);
        });
      });
      if (sync) history.replaceState(null, "", `${location.pathname}?style=${style.slug}`);
    }

    const requested = new URLSearchParams(location.search).get("style");
    render(requested ?? select?.value ?? records[0]?.style.slug, false);
    select?.addEventListener("change", () => render(select.value));
    document.querySelector("[data-compare-prev]")?.addEventListener("click", () => {
      if (!select) return;
      const index = Math.max(0, records.findIndex((item) => item.style.slug === select.value));
      render(records[(index - 1 + records.length) % records.length].style.slug);
    });
    document.querySelector("[data-compare-next]")?.addEventListener("click", () => {
      if (!select) return;
      const index = Math.max(0, records.findIndex((item) => item.style.slug === select.value));
      render(records[(index + 1) % records.length].style.slug);
    });
  </script>
</BaseLayout>
