---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Không tìm thấy trang | Prompt Atlas" description="Trang bạn tìm không tồn tại trong Prompt Atlas." canonicalPath="/404.html" bodyClass="not-found-page">
  <section class="not-found shell">
    <div class="not-found__code" aria-hidden="true">404</div>
    <div>
      <p class="eyebrow">LỆCH KHUNG HÌNH</p>
      <h1>Phong cách này chưa nằm trong atlas.</h1>
      <p>Quay lại kho 90 phong cách hoặc mở bàn so sánh để tiếp tục khám phá.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/#atlas">Về kho phong cách</a>
        <a class="button button--ghost" href="/compare/">Mở bàn so sánh</a>
      </div>
    </div>
  </section>
</BaseLayout>
