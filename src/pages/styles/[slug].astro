---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FavoriteButton from "../../components/FavoriteButton.astro";
import PairCard from "../../components/PairCard.astro";
import PromptBlock from "../../components/PromptBlock.astro";
import Icon from "../../components/Icon.astro";
import ComposerEntry from "../../components/ComposerEntry.astro";
import PromptAnatomy from "../../components/PromptAnatomy.astro";
import EvidencePanel from "../../components/EvidencePanel.astro";
import { evidenceForStyle, promptSourceForStyle } from "../../lib/evidence";
import { paddedId, styleBySlug, styleRoutes, styles, type StyleRecord } from "../../lib/styles";

export function getStaticPaths() {
  return styleRoutes.map(({ routeSlug, style }) => ({ params: { slug: routeSlug }, props: { style, routeSlug } }));
}

type Props = { style: StyleRecord; routeSlug: string };
const { style, routeSlug } = Astro.props;
const related = style.related.map(styleBySlug).filter((item): item is StyleRecord => Boolean(item));
const evidence = evidenceForStyle(style);
const promptSource = promptSourceForStyle(style);
const output = evidence.representative?.result ?? {
  path: style.images.chatgpt.full,
  width: style.images.chatgpt.width,
  height: style.images.chatgpt.height,
  alt: `${style.name} — ảnh tham chiếu.`,
};
const description = `${style.name}: xem output, hiểu prompt anatomy, cách dùng và đưa phong cách vào Composer.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: `${style.name} — Prompt Atlas`,
  description,
  url: `https://prompt-atlas.ldktech.com/styles/${style.slug}/`,
  image: `https://prompt-atlas.ldktech.com${output.path}`,
  isPartOf: { "@type": "CollectionPage", name: "Prompt Atlas" },
};
const isLegacyAlias = routeSlug !== style.slug;
---

<BaseLayout
  title={`${style.name}: output và prompt anatomy | Prompt Atlas`}
  description={description}
  canonicalPath={`/styles/${style.slug}/`}
  image={output.path}
  bodyClass="detail-page"
  jsonLd={jsonLd}
>
  <article>
    <header class="detail-hero shell">
      <nav class="breadcrumb" aria-label="Đường dẫn">
        <a href="/">Atlas</a><span aria-hidden="true">/</span><span>{paddedId(style.id)}</span>
      </nav>
      <div class="detail-hero__grid">
        <div>
          <p class="eyebrow">{style.family} / PHONG CÁCH {paddedId(style.id)}</p>
          <h1>{style.name}</h1>
          <p class="detail-hero__subtitle">{style.subtitle}</p>
        </div>
        <div class="detail-hero__summary">
          <p>{style.summary}</p>
          <ul aria-label="Dấu hiệu nhận biết">
            {style.cues.map((cue) => <li>{cue}</li>)}
          </ul>
          <div class="detail-hero__actions"><FavoriteButton slug={style.slug} name={style.name} /></div>
        </div>
      </div>
      {isLegacyAlias && <p class="legacy-alias-note">Route cũ <code>/styles/{routeSlug}/</code> được giữ để tương thích. Tên chuẩn V2 là <a href={`/styles/${style.slug}/`}>{style.name}</a>.</p>}
    </header>

    <section class="learning-output shell" data-learning-step="output" aria-labelledby={`output-${style.slug}`}>
      <div class="learning-step__head">
        <p class="step-number">01 / OUTPUT + PROMPT</p>
        <div><h2 id={`output-${style.slug}`}>Nhìn kết quả, rồi đọc nguyên nhân.</h2><p>Ảnh và prompt đứng cạnh nhau để bạn đối chiếu trực tiếp từng lựa chọn ngôn ngữ.</p></div>
      </div>
      <div class="output-prompt-grid">
        <figure class="learning-output__plate" data-learning-output>
          <img src={output.path} width={output.width} height={output.height} alt={output.alt} fetchpriority="high" />
          <figcaption><span>OUTPUT / {paddedId(style.id)}</span><strong>{style.name}</strong></figcaption>
        </figure>
        <div data-prompt-anchor>
          <PromptBlock sourcePrompt={style.sourcePrompt} generationPrompt={style.generationPrompt} id={`prompt-${style.slug}`} />
          {promptSource && (
            <dl class="prompt-source" data-prompt-source>
              <div><dt>Nguồn prompt</dt><dd>{promptSource.reference}</dd></div>
              <div><dt>Tác giả</dt><dd>{promptSource.author}</dd></div>
              <div>
                <dt>Liên kết</dt>
                <dd><a href={promptSource.url}>Mở nguồn trên GitHub <Icon name="arrow-up-right" size={16} /></a></dd>
              </div>
            </dl>
          )}
        </div>
      </div>
    </section>

    <PromptAnatomy style={style} />

    <section class="how-to-use shell" data-how-to-use data-learning-step="how-to-use" aria-labelledby={`use-${style.slug}`}>
      <div class="learning-step__head">
        <p class="step-number">03 / CÁCH DÙNG</p>
        <div><h2 id={`use-${style.slug}`}>Giữ ngôn ngữ, thay nội dung.</h2><p>Bắt đầu bằng một thay đổi nhỏ; xem output mới trước khi thêm nhiều primitive.</p></div>
      </div>
      <div class="usage-grid">
        <article><span>GIỮ</span><h3>Dấu hiệu phong cách</h3><ul>{style.cues.map((cue) => <li>{cue}</li>)}</ul></article>
        <article><span>THAY</span><h3>Chủ thể và bối cảnh</h3><p>{style.sourcePrompt}</p><p>Thay câu này bằng đối tượng, hành động và bối cảnh của bạn.</p></article>
        <article><span>KIỂM TRA</span><h3>Output trước, score sau</h3><p>Đọc bố cục, vật liệu và artifact trên ảnh. Chỉ mở comparison khi evidence panel xác nhận đủ điều kiện.</p></article>
      </div>
    </section>

    <section class="compose-step shell" data-compose-step data-learning-step="compose" aria-labelledby={`compose-${style.slug}`}>
      <div>
        <p class="step-number">04 / COMPOSE</p>
        <h2 id={`compose-${style.slug}`}>Đưa phong cách này vào recipe.</h2>
        <p>Composer lưu local-first. Nếu primitive xung đột, hệ thống giải thích trước khi thay đổi recipe.</p>
      </div>
      <div class="compose-step__actions">
        <ComposerEntry style={style} variant="button" />
        <a class="button button--ghost" href="/composer/">Mở Composer <Icon name="arrow-right" /></a>
      </div>
    </section>

    <EvidencePanel style={style} />

    <section class="related-section shell" aria-labelledby="related-title">
      <div class="section-heading">
        <div><p class="eyebrow">TIẾP TỤC KHÁM PHÁ</p><h2 id="related-title">Phong cách cùng mạch.</h2></div>
        <a href="/#atlas">Xem đủ {styles.length} phong cách <Icon name="arrow-right" /></a>
      </div>
      <div class="style-grid style-grid--related">
        {related.map((item) => <PairCard style={item} />)}
      </div>
    </section>
  </article>
</BaseLayout>
