---
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ComposerTray from "../components/ComposerTray.astro";
import SharedDiscovery from "../components/SharedDiscovery.astro";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  bodyClass?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
};

const {
  title = "Prompt Atlas — nhìn output, hiểu prompt | LDKTech",
  description = "Kho tham chiếu prompt trực quan bằng tiếng Việt: nhìn output trước, hiểu prompt tạo ra nó, rồi đưa thành phần vào Composer.",
  canonicalPath = Astro.url.pathname,
  image = "/media/og-cover.webp",
  bodyClass = "",
  jsonLd,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const ogImage = new URL(image, Astro.site);
const brandIdentity = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Prompt Atlas",
  alternateName: "Prompt Atlas by LDKTech",
  url: new URL("/", Astro.site),
  description,
  inLanguage: "vi",
  publisher: {
    "@type": "Organization",
    name: "LDKTech",
    logo: {
      "@type": "ImageObject",
      url: new URL("/brand/prompt-atlas-mark-primary.svg", Astro.site),
    },
  },
};
const structuredData = jsonLd
  ? (Array.isArray(jsonLd) ? [brandIdentity, ...jsonLd] : [brandIdentity, jsonLd])
  : brandIdentity;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121311" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Prompt Atlas by LDKTech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
    <SiteHeader />
    <SharedDiscovery />
    <main id="main-content">
      <slot />
    </main>
    <ComposerTray />
    <SiteFooter />
    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>
    <script src="../scripts/global.ts"></script>
  </body>
</html>
