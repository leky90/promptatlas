{
  "name": "prompt-atlas-ldktech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prepare:data": "node scripts/prepare-site-data.mjs",
    "build:og-cover": "node scripts/build-og-cover.mjs",
    "smoke:production-domain": "node scripts/smoke-production-domain.mjs",
    "validate:dist-assets": "node scripts/validate-dist-assets.mjs",
    "import:legacy-assets": "node scripts/import-legacy-source-assets.mjs",
    "build:image-data": "node scripts/build-image-content.mjs",
    "check:image-data": "node scripts/build-image-content.mjs --check",
    "validate:image-data": "node scripts/validate-image-content.mjs",
    "generation:plan": "node scripts/generation-harness/cli.mjs plan",
    "generation:validate": "node scripts/generation-harness/cli.mjs validate",
    "generation:inspect-gflow": "node scripts/generation-harness/cli.mjs inspect-gflow",
    "generation:execute-gflow": "node scripts/generation-harness/cli.mjs execute-gflow",
    "generation:record-codex": "node scripts/generation-harness/cli.mjs record-codex",
    "build:primitive-assets": "node scripts/build-primitive-image-assets.mjs",
    "validate:primitive-assets": "node scripts/validate-primitive-image-assets.mjs",
    "check:generation-harness": "node scripts/generation-harness/cli.mjs plan --config schemas/examples/image-generation-harness.v1.config.json --check-deterministic",
    "check": "npm run check:image-data && npm run validate:image-data && npm run check:generation-harness && npm run validate:primitive-assets && astro check",
    "build": "npm run check:image-data && npm run validate:image-data && npm run check:generation-harness && npm run validate:primitive-assets && astro build",
    "verify:pages": "npm run test && npm run check && astro build && npm run validate:dist-assets",
    "preview": "astro preview",
    "validate:contract": "node scripts/validate-prompt-atlas-data.mjs schemas/examples/prompt-atlas.v1.example.json",
    "test:contract": "node --test contract-tests/*.test.mjs",
    "test:unit": "node --test tests/composer-domain.test.mjs",
    "test": "npm run test:unit && npm run test:contract",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  }
}
