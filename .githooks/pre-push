#!/bin/sh

# Local guard for the production branch. Cloudflare Pages repeats the same gate
# in its own build environment before it creates a deployment.
check_main=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  check_main=1
done

if [ "$check_main" -eq 0 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: npm is required to verify main." >&2
  exit 1
fi

echo "pre-push: running the Cloudflare Pages production gate…"
npm run verify:pages </dev/null || {
  echo "pre-push: production gate failed; push stopped." >&2
  exit 1
}

echo "pre-push: production gate passed."
